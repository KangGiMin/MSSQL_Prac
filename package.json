{
  "name": "query-ground",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "node --watch server/index.mjs",
    "build": "vite build",
    "start": "node server/index.mjs",
    "db:setup": "node scripts/setup-db.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node scripts/integration-test.mjs",
    "test:http": "node scripts/smoke-http.mjs",
    "test:render": "node scripts/check-render.mjs",
    "test:regression": "node scripts/regression-db.mjs",
    "test:browser": "playwright test",
    "test:ports": "node scripts/check-ports.mjs",
    "verify": "node scripts/verify.mjs",
    "format": "prettier --write src server shared scripts tests *.js index.html package.json",
    "format:check": "prettier --check src server shared scripts tests *.js index.html package.json",
    "pdf:import": "node scripts/import-pdf.mjs"
  },
  "dependencies": {
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@uiw/react-codemirror": "^4.25.0",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "msnodesqlv8": "^5.0.0",
    "mssql": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@vitejs/plugin-react": "^5.0.0",
    "pdfjs-dist": "^6.5.438",
    "prettier": "^3.10.1",
    "vite": "^7.0.0"
  }
}
