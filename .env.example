HOST=127.0.0.1
PORT=3001
CLIENT_PORT=5173
SQL_SERVER=localhost
SQL_DRIVER=ODBC Driver 17 for SQL Server
SQL_AUTH=windows
# SQL_AUTH=sql 일 때만 필요합니다.
# SQL_USER=queryground
# SQL_PASSWORD=change-me
SQL_ENCRYPT=false
SQL_TRUST_CERTIFICATE=true
QUERY_TIMEOUT_MS=15000
MAX_RESULT_ROWS=1000
MAX_RESULT_MB=8

# 아래 설정은 외부 배포용입니다. 로컬 실행에는 추가하지 않아도 됩니다.
# DEPLOYMENT_MODE=hosted
# APP_ACCESS=public
# 비공개 접속이 필요하면 APP_ACCESS=private와 아래 계정 값을 지정합니다.
# PUBLIC_ORIGIN=https://your-app.onrender.com
# APP_USER=queryground
# APP_PASSWORD=replace-with-a-long-random-password
# SQL_PLATFORM=azure
# Azure SQL에는 SQL_AUTH=sql, SQL_ENCRYPT=true,
# SQL_TRUST_CERTIFICATE=false와 외부 SQL 접속 정보가 필요합니다.
